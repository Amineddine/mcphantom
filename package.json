{
  "name": "mcphantom",
  "version": "0.1.0",
  "description": "Security gateway for MCP: tool-poisoning and rug-pull detection, taint tracking across the LLM boundary, declarative per-tool policy.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "mcphantom": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:latency": "tsx bench/latency.ts",
    "bench:scanner": "tsx bench/scanner-bench.mts",
    "bench:policy": "tsx bench/policy-bench.mts",
    "bench:evasion": "tsx bench/evasion-bench.mts",
    "bench:entropy": "tsx bench/entropy-bench.mts",
    "bench:posthog": "tsx bench/posthog-scan.mts",
    "bench:may-receive": "tsx bench/may-receive-bench.mts",
    "demo": "tsx src/demo/run.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "prompt-injection",
    "taint-tracking",
    "llm"
  ],
  "dependencies": {
    "@bufbuild/cel": "0.6.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
